# Backend Configuration
# AI_PROVIDER picks the default LLM for every agent: anthropic | local | openai | grok
AI_PROVIDER=anthropic

# Claude (default provider)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-opus-4-8

# Second endpoint: any OpenAI-compatible server (vLLM / LM Studio / llama.cpp)
LOCAL_LLM_BASE_URL=http://localhost:8001/v1
LOCAL_LLM_MODEL=google/gemma-4-26B-A4B-it
# LOCAL_LLM_API_KEY=only_if_your_server_requires_one

# Agent-1: AI-Times
YOUTUBE_API_KEY=your_youtube_api_key_here

# Agent-3: Wallstreet Wolf
# No API key required for yfinance

# Agent-4: GitHub Trending
GITHUB_TOKEN=your_github_pat_here

# Agent: Compass (market bias + key levels)
# No API key required — uses yfinance (sector ETFs + pivots) and Yahoo RSS headlines

# Agent-13: Alpha Wolf — paper trading via Alpaca (https://alpaca.markets)
# Free paper-trading account: sign up, then Dashboard → Paper Trading → API Keys.
ALPACA_API_KEY_ID=your_alpaca_paper_key_id_here
ALPACA_API_SECRET_KEY=your_alpaca_paper_secret_key_here
ALPACA_TRADING_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_BASE_URL=https://data.alpaca.markets
