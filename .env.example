# Backend Configuration
# AI_PROVIDER picks the default LLM for every agent: anthropic | local | ollama | openai | grok
AI_PROVIDER=anthropic

# Claude (default provider)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-opus-4-8

# Second endpoint: any OpenAI-compatible server (vLLM / LM Studio / llama.cpp)
LOCAL_LLM_BASE_URL=http://localhost:8001/v1
LOCAL_LLM_MODEL=google/gemma-4-26B-A4B-it
# LOCAL_LLM_API_KEY=only_if_your_server_requires_one

# Ollama (final fallback when cloud/local endpoints are unavailable)
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen3.5:4b

# Email Configuration (Gmail SMTP)
DAILY_DIGEST_EMAIL=your_email@gmail.com
SMTP_APP_PASSWORD=your_gmail_app_password_here

# Agent-1: AI-Times
YOUTUBE_API_KEY=your_youtube_api_key_here

# Agent-2: Mailman
# Requires credentials.json from Google Cloud Console in the backend directory
KEY_PEOPLE=boss@company.com,vip@example.com

# Agent-3: Wallstreet Wolf
# No API key required for yfinance

# Agent-4: GitHub Trending
GITHUB_TOKEN=your_github_pat_here

# Agent: Compass (market bias + key levels)
# No API key required — uses yfinance (sector ETFs + pivots) and Yahoo RSS headlines

# Agent: Aegis (Islamophobia watch & forum-moderation assistant)
# Topic / keyword to watch for across Reddit + Hacker News. No API key required.
AEGIS_BRAND=Islamophobia
